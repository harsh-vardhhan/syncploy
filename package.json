{
  "name": "syncploy",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "bun --filter \"*\" build",
    "build:packages": "bun --filter \"@syncploy/*\" build",
    "build:web": "bun --filter syncploy-web build",
    "dev": "bun --filter \"*\" dev",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && bun --filter syncploy-web typecheck && bun --filter @syncploy/desktop typecheck",
    "typecheck:packages": "tsc --noEmit",
    "typecheck:web": "bun --filter syncploy-web typecheck",
    "typecheck:desktop": "bun --filter @syncploy/desktop typecheck",
    "package:plugin": "bun run ./scripts/package-plugin.ts",
    "audit:security": "bun run ./scripts/audit-security.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.5",
    "bun-types": "^1.4.4",
    "typescript": "^5.7.3"
  }
}
