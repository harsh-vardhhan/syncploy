{
  "name": "syncploy",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "bun --filter \"*\" build",
    "dev": "bun --filter \"*\" dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit && bun --filter syncploy-web typecheck",
    "package:plugin": "bun run ./scripts/package-plugin.ts",
    "audit:security": "bun run ./scripts/audit-security.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "bun-types": "^1.4.4",
    "typescript": "^5.7.3"
  }
}
