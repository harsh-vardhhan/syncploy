{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "types": ["bun-types"],
    "baseUrl": ".",
    "paths": {
      "@syncploy/sdk": ["packages/sdk/src/index.ts"],
      "@syncploy/compiler": ["packages/compiler/src/index.ts"]
    }
  },
  "include": ["packages/**/*", "examples/**/*"],
  "exclude": ["node_modules", "dist", "apps"]
}
