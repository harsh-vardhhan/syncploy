{
  "name": "@syncploy/sdk",
  "version": "0.1.4",
  "description": "Infrastructure-from-Code (IfC) Runtime SDK for Pure AWS Serverless",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "author": "Harsh Vardhan <harsh.vardhan.611@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harsh-vardhhan/syncploy.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/harsh-vardhhan/syncploy#readme",
  "bugs": {
    "url": "https://github.com/harsh-vardhhan/syncploy/issues"
  },
  "keywords": [
    "aws",
    "serverless",
    "infrastructure-from-code",
    "ifc",
    "lambda",
    "dynamodb",
    "s3",
    "sqs",
    "sns",
    "firehose",
    "cloudformation"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.750.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/client-sns": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.750.0",
    "@aws-sdk/lib-dynamodb": "^3.750.0"
  }
}
